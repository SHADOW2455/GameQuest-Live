# Local default is SQLite. For production use managed PostgreSQL.
DATABASE_URL=sqlite:///./gamequest.db
ENABLE_SCHEDULER=true
COLLECT_INTERVAL_MINUTES=30
VERIFY_INTERVAL_MINUTES=60
# Greenhouse board slug examples: rockstargames (verify each board before adding).
GREENHOUSE_BOARDS=rockstargames
# Lever site slugs are company-specific. Leave empty until you identify valid slugs.
LEVER_BOARDS=
# Optional public job-board APIs. Slugs must be verified for each employer.
ASHBY_BOARDS=
SMARTRECRUITERS_COMPANIES=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_TO=
CORS_ORIGINS=*
LOG_LEVEL=INFO
